{% if language == "en" -%}
# IC Mock Interview Report

## 1. Candidate Profile
- Resume path: {{ session.inputs.get("resume_path", "") }}
- Repo path: {{ session.inputs.get("repo_path", "") }}
- Direction: {{ session.profile.industry if session.profile else "" }}
- Focus: {{ ((session.profile.focus + session.profile.secondary_focus) | join(", ")) if session.profile else "" }}
- Question mix: {{ session.profile.question_mix if session.profile and session.profile.question_mix else "" }}

## 2. Project Summary
{% for project in session.resume.projects if session.resume %}
- {{ project.name }}
  - Summary: {{ project.summary }}
  - Claims:
{% for claim in project.claims %}
    - {{ claim }}
{% endfor %}
{% endfor %}

## 3. Interview Log
{% for qa in session.qa_log %}
### Q{{ loop.index }} [{{ qa.question.type|title }}] - {{ qa.question.project }}
**Question**
{{ qa.question.question }}

**Candidate Answer**
{{ qa.answer }}

**Anchors**
{% if qa.evaluation and qa.evaluation.anchors %}
{% for anchor in qa.evaluation.anchors %}
- {{ anchor }}
{% endfor %}
{% else %}
- N/A
{% endif %}

**Evaluation**
- Summary: {{ qa.evaluation.summary if qa.evaluation else "" }}
- Strengths:
{% if qa.evaluation and qa.evaluation.strengths %}
{% for strength in qa.evaluation.strengths %}
  - {{ strength }}
{% endfor %}
{% else %}
  - N/A
{% endif %}
- Gaps:
{% if qa.evaluation and qa.evaluation.gaps %}
{% for gap in qa.evaluation.gaps %}
  - {{ gap }}
{% endfor %}
{% else %}
  - N/A
{% endif %}

**Standard Answer**
{{ qa.evaluation.standard_answer if qa.evaluation else "" }}

**Memorization Version**
{{ qa.evaluation.memorization_answer if qa.evaluation else "" }}

{% endfor %}
## 4. Overall Feedback
- Strengths:
{% for item in overall_feedback.strengths %}
  - {{ item }}
{% endfor %}
- Gaps:
{% for item in overall_feedback.gaps %}
  - {{ item }}
{% endfor %}
 - Recommendation: {{ overall_feedback.recommendation }}
{% else -%}
